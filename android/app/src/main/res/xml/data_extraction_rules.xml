<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: ни облачный бэкап, ни перенос на новое устройство не трогают
     данные приложения. Иначе флаг установки восстановился бы без токенов из
     Keystore, а зашифрованные токены — без ключа, которым их можно прочитать. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
